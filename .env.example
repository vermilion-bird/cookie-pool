# ── Cookie Pool 环境变量 ──
# 复制此文件为 .env 并修改

# === 主机地址（必填）===
# 部署机器的公网 IP 或域名，用于生成 noVNC 访问链接
HOST_ADDRESS=127.0.0.1

# === 端口配置 ===
# Web UI + API 端口
APP_PORT=8080
# noVNC 网页端口（Chrome 远程桌面）
NOVNC_PORT=7901

# === API 密钥 ===
# 用于调用 API 的认证 key（当前版本预留）
API_KEY=change-me-to-a-random-string

# === VNC 密码（可选）===
# 设置后 noVNC 访问需要密码认证；留空则无密码
VNC_PASSWORD=

# === Grid 配置 ===
# 同时最大会话数（建议 1~5，取决于机器性能）
GRID_MAX_SESSIONS=1
# 会话超时秒数
GRID_SESSION_TIMEOUT=300

# === Selenium Standalone 镜像版本 ===
# 固定版本保证可重现；latest 自动跟随最新
GRID_IMAGE=selenium/standalone-chromium:latest

# === 数据目录（相对项目根目录）===
DATA_DIR=./data
# Database: leave empty for SQLite, set to postgresql://user:pass@host:5432/db for PostgreSQL
DATABASE_URL=

