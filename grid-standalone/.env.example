# ── Selenium Standalone Grid 环境变量 ──
# 复制为 .env 后修改

# 容器名（同一主机多实例时改名避免冲突）
CONTAINER_NAME=selenium-grid

# 端口（多实例时改端口）
GRID_PORT=4444          # Selenium Grid API（设为 127.0.0.1:4444:4444 仅本地可访问）
NOVNC_PORT=7900         # noVNC 网页远程桌面
VNC_PORT=5900           # 原生 VNC（可设为 127.0.0.1:5900:5900 关闭外部访问）

# 会话配置
GRID_MAX_SESSIONS=1              # 同时最多几个 Chrome 实例
GRID_SESSION_TIMEOUT=300         # 空闲会话超时（秒）

# VNC 密码（可选；留空=无需密码即可连接 noVNC）
VNC_PASSWORD=

# 共享内存（Chrome 需要较大 shm；默认 2gb）
SHM_SIZE=2gb

# Selenium 镜像（固定版本或 latest）
GRID_IMAGE=selenium/standalone-chromium:latest

# Chrome profile 持久化目录（相对路径 = 本目录下）
PROFILES_DIR=./profiles

# 时区
TZ=Asia/Shanghai